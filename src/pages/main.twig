{% extends "../include/layout/default.twig" %}

{% block content %}

    {% view '&first' with { block: first } %}
    {% view '&screen' with { block: about|merge({ backgroundFill: 'white' }), id: 'about' } %}
    {% view '&screen' with { block: factoids|merge({ backgroundFill: 'green' }), id: 'factoids' } %}
    {% view '&screen' with { block: product|merge({ backgroundFill: 'grey' }), id: 'product' } %}
    {% view '&screen' with { block: services|merge({ backgroundFill: 'white' }), id: 'services' } %}
    {% view '&screen' with { block: projects|merge({ backgroundFill: 'grey' }), id: 'projects' } %}
    {% view '&screen' with { block: howWeWork|merge({ backgroundFill: 'white' }), id: 'howWeWork' } %}
    {% view '&screen' with { block: partners|merge({ backgroundFill: 'white' }), id: 'partners' } %}
    {% view '&screen' with { block: people|merge({ backgroundFill: 'green' }), id: 'people' } %}
    {% view '&form-section' with { block: form } %}
    {% view '&map' with { block: map } %}

{% endblock %}
