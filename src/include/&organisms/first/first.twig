<div class="first">
    {% if block.background %}
        <img class="first__bg first__bg--desktop" src="{{ block.background.src }}" alt="{{ block.background.alt }}">
        {% if block.background.src_mobile %}
            <img class="first__bg first__bg--mobile" src="{{ block.background.src_mobile }}" alt="{{ block.background.alt }}">
        {% endif %}
    {% endif %}
    <div class="container">
        <div class="first__content">
            {% if block.socials %}
                <div class="first__socials">
                    {% view '&socials' with {block:block.socials} %}
                </div>
            {% endif %}

            {% if block.title %}
                <h1 class="first__title">
                    {{ block.title }}
                </h1>
            {% endif %}

            {% if block.button %}
                <div class="first__button">
                    {% view '@button' with {button: block.button} %}
                </div>
            {% endif %}
        </div>
    </div>
</div>