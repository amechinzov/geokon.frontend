{% set logoIcon = header.logo.icon ?: {
    name:  'logos/logo'
} %}
<header class="header{% if header.theme %} header--{{ header.theme }}{% endif %}{% if header.pin %} is-pinned{% endif %}" {% if header.pin %} data-header-pin {% endif %} {% if header.hiding %} data-header-hiding {% endif %}>
    <div class=" header__container container" data-animate-custom>
        <div class=" header__inner">
            <div class="header__content">
                <button class="header__burger" data-burger aria-label="Меню"><span></span></button>
                <div class="header__top">
                    {% if header.top %}
                        {% for item in header.top %}
                            <div class="header__item">
                                {% if item.href %}
                                    <a href="{{ item.href }}" class="header__link" data-header-link{% if item.external %} target="_blank" rel="nofollow" {% endif %}>
                                        {% if item.image %}
                                            {% view '@image' with {image: item.image} %}
                                        {% else %}
                                            {% if item.icon %}{% view '@icon' with {icon: item.icon} %}{% endif %}{{ item.text }}
                                        {% endif %}
                                    </a>
                                {% else %}
                                    <span class="header__link">{% if item.icon %}{% view '@icon' with {icon: item.icon} %}{% endif %}{{ item.text }}</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
                <div class="header__menu">
                    {% for item in header.menu %}
                        <div class="header__item">
                            {% if item.selected %}
                                <span class="header__link header__menu-item is-selected">{{ item.text }}</span>
                            {% elseif item.href %}
                                <a href="{{ item.href }}" class="header__link header__menu-item" data-header-link{% if item.external %} target="_blank" rel="nofollow" {% endif %}>{{ item.text }}</a>
                            {% else %}
                                <span class="header__link header__menu-item">{{ item.text }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</header>