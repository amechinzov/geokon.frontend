<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="ie=edge">

		{% if title %}
			<title>{{ title }}</title>
		{% else %}
			<title>Default title</title>
		{% endif %}

		{# generated on https://realfavicongenerator.net/ #}
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
		<link rel="shortcut icon" href="/favicon.ico"/>
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
		<link
		rel="manifest" href="/site.webmanifest"/>

		{# Все сгенерированные CSS #}
		{% if cssFiles is defined %}
			{% for cssFile in cssFiles %}
				<link href="{{ cssFile }}" rel="stylesheet">
			{% endfor %}
		{% endif %}
	</head>
	<body>

        {% if header %}
            {% view '&header' with {header: header} %}
        {% endif %}

        {% if menu %}
            {% view '&menu' with {menu: menu} %}
        {% endif %}

		{% block content %}{% endblock %}

		{# Все сгенерированные JS #}
		{% if jsFiles is defined %}
			{% for jsFile in jsFiles %}
				<script src="{{ jsFile }}" defer></script>
			{% endfor %}
		{% endif %}

        {% if footer %}
            {% view '&footer' with {footer: footer} %}
        {% endif %}

	</body>
</html>
