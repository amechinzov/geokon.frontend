{% if project.href %}
<a href="javascript:void(0);" data-modal="{{ project.href }}" class="project {{ project.class }}" {{ project.attr }} {% if project.external %} target="_blank" rel="nofollow" {% endif %}>
    {% if project.image %}
        <div class="project__image">
            {% view '@image' with { image: project.image } %}
        </div>
    {% endif %}
    {% if project.tags %}
        <div class="project__tags">
            {% for tag in project.tags %}
                <div class="project__tag">
                    {{ tag }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if project.title %}
        <div class="project__title">
            {{ project.title }}
        </div>
    {% endif %}

    {% if project.description %}
        <div class="project__description">
            {{ project.description }}
        </div>
    {% endif %}

    {% if project.link %}
        <div class="project__link">
            {{ project.link }}{% svg "20/arrow-right" %}
        </div>
    {% endif %}
</a>
{% else %}
    {% if project.image %}
        <div class="project__image">
            {% view '@image' with { image: project.image } %}
        </div>
    {% endif %}
    {% if project.tags %}
        <div class="project__tags">
            {% for tag in project.tags %}
                <div class="project__tag">
                    {{ tag }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if project.title %}
        <div class="project__title">
            {{ project.title }}
        </div>
    {% endif %}

    {% if project.description %}
        <div class="project__description">
            {{ project.description }}
        </div>
    {% endif %}

    {% if project.link %}
        <div class="project__link">
            {{ project.link }}
        </div>
    {% endif %}
{% endif %}
